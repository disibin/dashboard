  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_tickets_modtime 
BEFORE UPDATE ON tickets 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_tickets_created_by ON tickets(created_by);
CREATE TABLE IF NOT EXISTS ticket_participants (
  id SERIAL PRIMARY KEY,
  ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  staff_id INT REFERENCES staffs(id) ON DELETE CASCADE,
  CHECK (
    (user_id IS NOT NULL AND staff_id IS NULL)
    OR
    (user_id IS NULL AND staff_id IS NOT NULL)
  ),
  last_read_at TIMESTAMP,
  joined_at TIMESTAMP DEFAULT now(),
  UNIQUE(ticket_id, user_id, staff_id)
);
CREATE INDEX idx_ticket_participants_ticket_id ON ticket_participants(ticket_id);
CREATE INDEX idx_ticket_participants_user_id ON ticket_participants(user_id);
CREATE INDEX idx_ticket_participants_staff_id ON ticket_participants(staff_id);
CREATE TABLE IF NOT EXISTS ticket_messages (
  id SERIAL PRIMARY KEY,
  ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND staff_id IS NULL)
    OR
    (user_id IS NULL AND staff_id IS NOT NULL)
  ),
  message TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_ticket_messages_ticket_id ON ticket_messages(ticket_id);
CREATE INDEX idx_ticket_messages_user_id ON ticket_messages(user_id);
CREATE INDEX idx_ticket_messages_staff_id ON ticket_messages(staff_id);
CREATE INDEX idx_ticket_messages_created_at ON ticket_messages(ticket_id, created_at);
CREATE TABLE IF NOT EXISTS ticket_attachments (
  id SERIAL PRIMARY KEY,
  ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND staff_id IS NULL)
    OR
    (user_id IS NULL AND staff_id IS NOT NULL)
  ),
  file_url TEXT NOT NULL,
  file_id TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_ticket_attachments_ticket_id ON ticket_attachments(ticket_id);
CREATE INDEX idx_ticket_attachments_user_id ON ticket_attachments(user_id);
CREATE INDEX idx_ticket_attachments_staff_id ON ticket_attachments(staff_id);
CREATE TABLE IF NOT EXISTS ticket_images (
  id SERIAL PRIMARY KEY,
  ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND staff_id IS NULL)
    OR
    (user_id IS NULL AND staff_id IS NOT NULL)
  ),
  file_url TEXT NOT NULL,
  file_id TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_ticket_images_ticket_id ON ticket_images(ticket_id);
CREATE INDEX idx_ticket_images_user_id ON ticket_images(user_id);
CREATE INDEX idx_ticket_images_staff_id ON ticket_images(staff_id);
CREATE TABLE IF NOT EXISTS boards (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  post TEXT NOT NULL,
  email TEXT UNIQUE,
  image TEXT,
  image_id TEXT,
  bio TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_boards_email ON boards(email);
CREATE TABLE IF NOT EXISTS careers (
  job_id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  location TEXT NOT NULL,
  job_type TEXT NOT NULL, 
  level TEXT NOT NULL, 
  compensation TEXT,
  description TEXT NOT NULL,
  responsibilities TEXT[],
  skills TEXT[],
  nice_to_have TEXT[],
  is_published BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_careers_is_published ON careers(is_published);
CREATE INDEX idx_careers_job_type ON careers(job_type);
CREATE TABLE IF NOT EXISTS career_applications (
  app_id SERIAL PRIMARY KEY,
  job_id INT REFERENCES careers(job_id) ON DELETE CASCADE,
  full_name TEXT NOT NULL,
  email TEXT NOT NULL,
  resume_url TEXT NOT NULL,
  cover_letter TEXT,
  status TEXT DEFAULT 'applied' CHECK (status IN ('applied', 'interviewing', 'rejected', 'hired')),
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_career_applications_job_id ON career_applications(job_id);
CREATE INDEX idx_career_applications_status ON career_applications(status);
CREATE TABLE IF NOT EXISTS reviews (
  id SERIAL PRIMARY KEY,
  user_id INT REFERENCES users(id) ON DELETE CASCADE UNIQUE,
  tenant_name TEXT,
  rating INT CHECK (rating BETWEEN 1 AND 5),
  comment TEXT,
  reply TEXT,
  is_approved BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_reviews_user_id ON reviews(user_id);
CREATE INDEX idx_reviews_is_approved ON reviews(is_approved);
CREATE TABLE IF NOT EXISTS notifications (
  id SERIAL PRIMARY KEY,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  message TEXT NOT NULL,
  link TEXT,
  type TEXT DEFAULT 'info',
  is_read BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_notifications_user_id ON notifications(user_id);
CREATE INDEX idx_notifications_is_read ON notifications(user_id, is_read);
CREATE TABLE IF NOT EXISTS activity_logs (
  id SERIAL PRIMARY KEY,
  staff_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  action TEXT NOT NULL,
  entity_type TEXT,
  entity_id INT,
  description TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_activity_logs_staff_id ON activity_logs(staff_id);
CREATE INDEX idx_activity_logs_entity ON activity_logs(entity_type, entity_id);
CREATE TABLE IF NOT EXISTS staff_login_logs (
  id SERIAL PRIMARY KEY,
  staff_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  action TEXT NOT NULL,
  entity_type TEXT,
  entity_id INT,
  description TEXT,
  status TEXT DEFAULT 'success' CHECK(status IN ('success','fail')),
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_staff_login_logs_staff_id ON staff_login_logs(staff_id);
CREATE TABLE IF NOT EXISTS user_login_logs (
  id SERIAL PRIMARY KEY,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  action TEXT NOT NULL,
  entity_type TEXT,
  entity_id INT,
  description TEXT,
  status TEXT DEFAULT 'success' CHECK(status IN ('success','fail')),
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_user_login_logs_user_id ON user_login_logs(user_id);
CREATE TABLE IF NOT EXISTS partners (
  id SERIAL PRIMARY KEY,
  company_name TEXT UNIQUE NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  business_url TEXT NOT NULL, 
  image TEXT NOT NULL,
  image_id TEXT NOT NULL,
  email TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_partners_slug ON partners(slug);
CREATE TABLE IF NOT EXISTS business_leads (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  phone TEXT,
  address TEXT,
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_business_leads_email ON business_leads(email);
CREATE TABLE IF NOT EXISTS client_leads (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  phone TEXT,
  address TEXT,
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_client_leads_email ON client_leads(email);
CREATE TABLE IF NOT EXISTS purchases (
  id SERIAL PRIMARY KEY,
  package_id INT REFERENCES packages(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  order_id TEXT,
  price INT NOT NULL,
  discount INT DEFAULT 0,
  status TEXT DEFAULT 'incomplete' CHECK (status IN ('incomplete', 'pending', 'complete', 'cancelled')),
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_purchases_modtime 
BEFORE UPDATE ON purchases 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_purchases_package_id ON purchases(package_id);
CREATE INDEX idx_purchases_user_id ON purchases(user_id);
CREATE INDEX idx_purchases_order_id ON purchases(order_id);
CREATE INDEX idx_purchases_status ON purchases(status);
CREATE TABLE IF NOT EXISTS payments (
  id SERIAL PRIMARY KEY,
  purchase_id INT REFERENCES purchases(id) ON DELETE CASCADE,
  order_id TEXT,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  price INT NOT NULL,
  paid INT DEFAULT 0,
  due INT DEFAULT 0,
  payment_method TEXT,
  transaction_id TEXT,
  sender_number TEXT,
  note TEXT,
  proof_url TEXT,
  status TEXT DEFAULT 'unpaid' CHECK (status IN ('unpaid', 'pending', 'paid', 'due', 'rejected')),
  verified_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  verified_at TIMESTAMP,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_payments_modtime 
BEFORE UPDATE ON payments 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_payments_purchase_id ON payments(purchase_id);
CREATE INDEX idx_payments_order_id ON payments(order_id);
CREATE INDEX idx_payments_user_id ON payments(user_id);
CREATE INDEX idx_payments_transaction_id ON payments(transaction_id);
CREATE INDEX idx_payments_status ON payments(status);
CREATE TABLE IF NOT EXISTS payroll (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  month INT CHECK (month BETWEEN 1 AND 12),
  year INT NOT NULL,
  total_amount INT DEFAULT 0,
  status TEXT DEFAULT 'pending' CHECK (status IN ('pending', 'approved', 'processed')),
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_payroll_modtime 
BEFORE UPDATE ON payroll 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_payroll_year_month ON payroll(year, month);
CREATE TABLE IF NOT EXISTS salary (
  id SERIAL PRIMARY KEY,
  staff_id INT REFERENCES staffs(id) ON DELETE CASCADE,
  payroll_id INT REFERENCES payroll(id) ON DELETE CASCADE,
  amount INT NOT NULL,
  paid_amount INT DEFAULT 0,
  due_amount INT DEFAULT 0,
  status TEXT DEFAULT 'unpaid' CHECK (status IN ('unpaid', 'partially_paid', 'paid')),
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_salary_modtime 
BEFORE UPDATE ON salary 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_salary_staff_id ON salary(staff_id);
CREATE INDEX idx_salary_payroll_id ON salary(payroll_id);
CREATE INDEX idx_salary_status ON salary(status);
CREATE TABLE IF NOT EXISTS salary_payments (
  id SERIAL PRIMARY KEY,
  salary_id INT REFERENCES salary(id) ON DELETE CASCADE,
  amount INT NOT NULL,
  payment_method TEXT,
  note TEXT,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_salary_payments_modtime 
BEFORE UPDATE ON salary_payments 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_salary_payments_salary_id ON salary_payments(salary_id);
CREATE TABLE IF NOT EXISTS news_letters (
  id SERIAL PRIMARY KEY,
  subject TEXT NOT NULL,
  description TEXT,
  image TEXT NOT NULL,
  image_id TEXT NOT NULL,
  created_by INT REFERENCES staffs(id) ON DELETE CASCADE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_news_letters_modtime 
BEFORE UPDATE ON news_letters 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_news_letters_created_by ON news_letters(created_by);
CREATE TABLE IF NOT EXISTS privacy_policies (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  is_published BOOLEAN DEFAULT true,
  order_num INT DEFAULT 0,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  updated_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_privacy_policies_modtime 
BEFORE UPDATE ON privacy_policies 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TABLE IF NOT EXISTS terms_and_conditions (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  is_published BOOLEAN DEFAULT true,
  order_num INT DEFAULT 0,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  updated_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_terms_and_conditions_modtime 
BEFORE UPDATE ON terms_and_conditions 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TABLE IF NOT EXISTS refund_conditions (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  is_published BOOLEAN DEFAULT true,
  order_num INT DEFAULT 0,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  updated_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_refund_conditions_modtime 
BEFORE UPDATE ON refund_conditions 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TABLE IF NOT EXISTS faqs (
  id SERIAL PRIMARY KEY,
  question TEXT NOT NULL,
  answer TEXT NOT NULL,
  is_published BOOLEAN DEFAULT true,
  order_num INT DEFAULT 0,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  updated_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_faqs_modtime 
BEFORE UPDATE ON faqs 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TABLE IF NOT EXISTS staff_notes (
  id SERIAL PRIMARY KEY,
  staff_id INT REFERENCES staffs(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  description TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_staff_notes_modtime 
BEFORE UPDATE ON staff_notes 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_staff_notes_staff_id ON staff_notes(staff_id);
CREATE TABLE IF NOT EXISTS staff_todos (
  id SERIAL PRIMARY KEY,
  staff_id INT REFERENCES staffs(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  description TEXT,
  start_time TIMESTAMP,
  end_time TIMESTAMP,
  is_completed BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_staff_todos_modtime 
BEFORE UPDATE ON staff_todos 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_staff_todos_staff_id ON staff_todos(staff_id);
CREATE INDEX idx_staff_todos_is_completed ON staff_todos(staff_id, is_completed);
CREATE TABLE IF NOT EXISTS blogs (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  description TEXT,
  image TEXT,
  image_id TEXT,
  tenant_id INT NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_blogs_modtime 
BEFORE UPDATE ON blogs 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_blogs_slug ON blogs(slug);
CREATE INDEX idx_blogs_tenant_id ON blogs(tenant_id);
CREATE INDEX idx_blogs_created_by ON blogs(created_by);
