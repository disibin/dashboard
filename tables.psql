CREATE OR REPLACE FUNCTION update_modified_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = now();
    RETURN NEW;
END;
$$ language 'plpgsql';
CREATE TABLE IF NOT EXISTS staffs (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT UNIQUE NOT NULL,
  phone TEXT UNIQUE,
  password TEXT NOT NULL,
  role TEXT DEFAULT 'support' CHECK (role IN ('support', 'manager', 'developer')),
  is_active BOOLEAN DEFAULT TRUE,
  is_verified BOOLEAN DEFAULT FALSE,
  reset_token TEXT,
  token_expires_at TIMESTAMP,
  verification_token TEXT,
  verification_expires_at TIMESTAMP,
  is_2fa_active BOOLEAN DEFAULT FALSE,
  two_fa_verification_token TEXT,
  two_fa_verification_expires_at TIMESTAMP,
  pending_email TEXT,
  email_change_code TEXT,
  email_change_expires_at TIMESTAMP,
  city TEXT,
  country TEXT,
  address_line1 TEXT,
  address_line2 TEXT,
  state TEXT,
  postal_code TEXT,
  last_login TIMESTAMP,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_staffs_modtime 
BEFORE UPDATE ON staffs 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_staffs_email ON staffs(email);
CREATE INDEX idx_staffs_role ON staffs(role);
CREATE INDEX idx_staffs_is_active ON staffs(is_active);
CREATE TABLE IF NOT EXISTS users (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT UNIQUE NOT NULL,
  phone TEXT UNIQUE,
  password TEXT NOT NULL,
  is_active BOOLEAN DEFAULT TRUE,
  is_verified BOOLEAN DEFAULT FALSE,
  reset_token TEXT,
  token_expires_at TIMESTAMP,
  verification_token TEXT,
  verification_expires_at TIMESTAMP,
  is_2fa_active BOOLEAN DEFAULT FALSE,
  two_fa_verification_token TEXT,
  two_fa_verification_expires_at TIMESTAMP,
  pending_email TEXT,
  email_change_code TEXT,
  email_change_expires_at TIMESTAMP,
  city TEXT,
  country TEXT,
  address_line1 TEXT,
  address_line2 TEXT,
  state TEXT,
  postal_code TEXT,
  last_login TIMESTAMP,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_users_modtime 
BEFORE UPDATE ON users 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_users_email ON users(email);
CREATE INDEX idx_users_is_active ON users(is_active);
CREATE TABLE IF NOT EXISTS tenants (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  url TEXT UNIQUE NOT NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_tenants_modtime 
BEFORE UPDATE ON tenants 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_tenants_url ON tenants(url);
CREATE TABLE IF NOT EXISTS products (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  title TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  image TEXT,
  image_id TEXT,
  link TEXT,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_products_modtime 
BEFORE UPDATE ON products 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_products_slug ON products(slug);
CREATE INDEX idx_products_created_by ON products(created_by);
CREATE TABLE IF NOT EXISTS features (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_features_name ON features(name);
CREATE INDEX idx_features_slug ON features(slug);
CREATE TABLE IF NOT EXISTS packages (
  id SERIAL PRIMARY KEY,
  tenant_id INT REFERENCES tenants(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  description TEXT,
  price INT DEFAULT 0,
  discount INT DEFAULT 0,
  image TEXT,
  image_id TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_packages_modtime 
BEFORE UPDATE ON packages 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_packages_tenant_id ON packages(tenant_id);
CREATE INDEX idx_packages_slug ON packages(slug);
CREATE TABLE IF NOT EXISTS package_features (
  id SERIAL PRIMARY KEY,
  package_id INT REFERENCES packages(id) ON DELETE CASCADE,
  feature_id INT REFERENCES features(id) ON DELETE CASCADE,
  value BOOLEAN DEFAULT TRUE,
  UNIQUE(package_id, feature_id)
);
CREATE INDEX idx_package_features_package_id ON package_features(package_id);
CREATE INDEX idx_package_features_feature_id ON package_features(feature_id);
CREATE TABLE IF NOT EXISTS user_cart (
  id SERIAL PRIMARY KEY,
  user_id INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  package_id INT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
  created_at TIMESTAMP DEFAULT now(),
  UNIQUE(user_id, package_id)
);
CREATE INDEX idx_user_cart_user_id ON user_cart(user_id);
CREATE INDEX idx_user_cart_package_id ON user_cart(package_id);
CREATE TABLE IF NOT EXISTS project_chats (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  description TEXT,
  status TEXT DEFAULT 'waiting' CHECK (status IN ('waiting', 'progress', 'working', 'completed', 'spam')),
  is_group BOOLEAN DEFAULT FALSE,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_project_chats_created_by ON project_chats(created_by);
CREATE TABLE IF NOT EXISTS project_chats_participants (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES project_chats(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  staff_id INT REFERENCES staffs(id) ON DELETE CASCADE,
  CHECK (
    (user_id IS NOT NULL AND staff_id IS NULL)
    OR
    (user_id IS NULL AND staff_id IS NOT NULL)
  ),
  last_read_at TIMESTAMP,
  joined_at TIMESTAMP DEFAULT now(),
  UNIQUE(chat_id, user_id, staff_id)
);
CREATE INDEX idx_project_chats_participants_chat_id ON project_chats_participants(chat_id);
CREATE INDEX idx_project_chats_participants_user_id ON project_chats_participants(user_id);
CREATE INDEX idx_project_chats_participants_staff_id ON project_chats_participants(staff_id);
CREATE TABLE IF NOT EXISTS project_chats_messages (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES project_chats(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND staff_id IS NULL)
    OR
    (user_id IS NULL AND staff_id IS NOT NULL)
  ),
  content TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_project_chats_messages_chat_id ON project_chats_messages(chat_id);
CREATE INDEX idx_project_chats_messages_user_id ON project_chats_messages(user_id);
CREATE INDEX idx_project_chats_messages_staff_id ON project_chats_messages(staff_id);
CREATE INDEX idx_project_chats_messages_created_at ON project_chats_messages(chat_id, created_at);
CREATE TABLE IF NOT EXISTS project_chats_images (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES project_chats(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND staff_id IS NULL)
    OR
    (user_id IS NULL AND staff_id IS NOT NULL)
  ),
  file_url TEXT NOT NULL,
  file_id TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_project_chats_images_chat_id ON project_chats_images(chat_id);
CREATE INDEX idx_project_chats_images_user_id ON project_chats_images(user_id);
CREATE INDEX idx_project_chats_images_staff_id ON project_chats_images(staff_id);
CREATE TABLE IF NOT EXISTS project_chats_files (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES project_chats(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  staff_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND staff_id IS NULL)
    OR
    (user_id IS NULL AND staff_id IS NOT NULL)
  ),
  file_url TEXT NOT NULL,
  file_id TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_project_chats_files_chat_id ON project_chats_files(chat_id);
CREATE INDEX idx_project_chats_files_user_id ON project_chats_files(user_id);
CREATE INDEX idx_project_chats_files_staff_id ON project_chats_files(staff_id);
CREATE TABLE IF NOT EXISTS chats (
  id SERIAL PRIMARY KEY,
  title TEXT,
  is_group BOOLEAN DEFAULT FALSE,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_chats_created_by ON chats(created_by);
CREATE TABLE IF NOT EXISTS chat_participants (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES chats(id) ON DELETE CASCADE,
  staff_id INT REFERENCES staffs(id) ON DELETE CASCADE,
  last_read_at TIMESTAMP,
  joined_at TIMESTAMP DEFAULT now(),
  UNIQUE(chat_id, staff_id)
);
CREATE INDEX idx_chat_participants_chat_id ON chat_participants(chat_id);
CREATE INDEX idx_chat_participants_staff_id ON chat_participants(staff_id);
CREATE TABLE IF NOT EXISTS chat_messages (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES chats(id) ON DELETE CASCADE,
  sender_id INT REFERENCES staffs(id) ON DELETE SET NULL,
  content TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_chat_messages_chat_id ON chat_messages(chat_id);
CREATE INDEX idx_chat_messages_sender_id ON chat_messages(sender_id);
CREATE INDEX idx_chat_messages_created_at ON chat_messages(chat_id, created_at);
CREATE TABLE IF NOT EXISTS chat_attachments (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES chats(id) ON DELETE CASCADE,
  sender_id INT REFERENCES staffs(id) ON DELETE CASCADE,
  image TEXT NOT NULL,
  image_id TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_chat_attachments_chat_id ON chat_attachments(chat_id);
CREATE INDEX idx_chat_attachments_sender_id ON chat_attachments(sender_id);
CREATE TABLE IF NOT EXISTS supports (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  subject TEXT NOT NULL,
  description TEXT NOT NULL,
  reply TEXT,                 
  status TEXT DEFAULT 'pending' CHECK(status IN ('pending', 'replied')),
  responded_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_supports_modtime 
BEFORE UPDATE ON supports 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_supports_email ON supports(email);
CREATE INDEX idx_supports_status ON supports(status);
CREATE INDEX idx_supports_responded_by ON supports(responded_by);
CREATE TABLE IF NOT EXISTS reports (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  subject TEXT NOT NULL,
  description TEXT NOT NULL,
  reply TEXT,                 
  status TEXT DEFAULT 'pending' CHECK(status IN ('pending', 'replied')),
  responded_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_reports_modtime 
BEFORE UPDATE ON reports 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_reports_email ON reports(email);
CREATE INDEX idx_reports_status ON reports(status);
CREATE INDEX idx_reports_responded_by ON reports(responded_by);
CREATE TABLE IF NOT EXISTS tickets (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
